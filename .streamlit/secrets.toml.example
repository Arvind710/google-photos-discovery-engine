# Copy to .streamlit/secrets.toml and fill in. NEVER commit the real file.
# On Streamlit Community Cloud these go in the app's Secrets panel instead.

# Ask AI and Try it only (P5). The read-only pages need no key: if this is
# missing, those pages render normally and Ask AI / Try it show a clear
# configuration message, not a stack trace (EC-OPS-5).
OPENAI_API_KEY = "sk-..."
