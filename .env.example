# Laptop-only pipeline credentials. Copy to .env (gitignored) and fill in.
# Never commit .env — the CI secret scan fails the build on a hit (T-18).
OPENAI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gp-discovery-engine/0.1 by u/<your-handle>
# Author-dedupe salt (EC-OPS-7). Any long random string; set it once and keep it.
AUTHOR_SALT=
